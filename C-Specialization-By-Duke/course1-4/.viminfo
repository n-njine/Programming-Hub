	      if(v>0) w[i]++;
	      else if (v<0) w[j]++;
	      else w[n_hands]++;
	    }
	  }
	  unsigned largest= 0;
	  for(int x=0;x<n_hands+1;x++){
	    if(w[x] > w[largest])largest=x;
	  }
	    int count=0;
	    if(w[n_hands]>0){
	      for(int x=0;x<n_hands+1;x++){
	        if(w[x] == w[largest]) count++;
	         }
	     }
	    if(count>1) return n_hands;
	  return  largest;
	}
	
	int main(int argc, char ** argv) {
	  //check arguments
	  if (argc < 2 ){
	    fprintf(stderr, "not enough number of arguments\n");
	    return EXIT_FAILURE ;
